{
  "name": "focus-tower",
  "version": "1.1.0",
  "private": true,
  "description": "Focus Tower monorepo — Chrome extension and mobile focus apps",
  "author": "Adrien Cominotto <adrien.cominotto@gmail.com>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "watch": "turbo run watch --filter=@focus-tower/chrome",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@focus-tower/chrome",
    "package": "turbo run package --filter=@focus-tower/chrome"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acominotto/focus-tower.git"
  },
  "license": "MIT",
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.0"
}
